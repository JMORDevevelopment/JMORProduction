# Uploaded files are user content and must never be executed (H6).
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .asp .aspx .jsp
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>

<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|bash|exe|asp|aspx|jsp|js)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
